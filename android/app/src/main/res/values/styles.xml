<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      LaunchTheme — shown from app tap until Flutter draws its FIRST frame.
      Using Theme.Black (dark) as parent so the status-bar icons are light-coloured,
      which looks correct on the deep-green background.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!--
      NormalTheme — Flutter applies this the moment it begins rendering.
      Setting windowBackground to the same green prevents a white flash
      between the native launch window and the first Flutter frame.
    -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
